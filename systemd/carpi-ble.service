[Unit]
Description=CarPi Bluetooth config service (phone picks what the logger records)
After=bluetooth.service
Wants=bluetooth.service

[Service]
User=carpi
SupplementaryGroups=bluetooth
WorkingDirectory=/home/carpi/carpi
# Bluetooth can come up soft-blocked; "+" runs this one line as root
ExecStartPre=+/usr/sbin/rfkill unblock bluetooth
# BlueZ's advertising API is refused on this Pi; carpi_ble.py then advertises through the
# kernel's Bluetooth management socket, which needs CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
ExecStart=/usr/bin/python3 -u carpi_ble.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
