[Unit]
Description=CarPi Bluetooth service (phone page: presets, live values, Pi settings)
After=bluetooth.service
Wants=bluetooth.service

[Service]
User=carpi
SupplementaryGroups=bluetooth
WorkingDirectory=/home/carpi/carpi
# Bluetooth can come up soft-blocked; "+" runs this one line as root
ExecStartPre=+/usr/sbin/rfkill unblock bluetooth
# CAP_NET_ADMIN: BlueZ's advertising API is refused on this Pi; carpi_ble.py then advertises
# through the kernel's Bluetooth management socket, which needs it.
# CAP_SYS_TIME: the Settings tab sets the clock from the phone when the Pi isn't synced
# (carpi_admin.py). Wi-Fi and shut down/restart go through polkit instead (pi-setup/50-carpi.rules).
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_TIME
ExecStart=/usr/bin/python3 -u carpi_ble.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
